# Copy to .env. Never commit real credentials.
PORT=8080
HOST=127.0.0.1
DATA_DIR=data
PORTAL_URL=http://localhost:8080/
ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080
# Gmail example only. propertymanager@gmail.com was a made-up address.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
IMAP_USER=
IMAP_PASSWORD=
# OAuth access token can be used instead of an app password.
IMAP_ACCESS_TOKEN=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional directory containing eng.traineddata.gz for offline OCR.
OCR_LANG_PATH=
