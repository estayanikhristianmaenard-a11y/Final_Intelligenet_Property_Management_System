# Clean setup template. The owner has chosen to share the team-owned .env as well.
# Use this template only if the shared .env is absent; do not overwrite it.
PORT=8080
HOST=127.0.0.1
TLS_CERT_FILE=
TLS_KEY_FILE=
DATA_DIR=data
PORTAL_URL=http://localhost:8080/
ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080
# Optional SMTP sending. Keep disabled until authorized sending credentials are configured.
RENT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rentara2026@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Rentara <rentara2026@gmail.com>"
# Incoming property-management mailbox. Enter the app password locally.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
IMAP_USER=rentara2026@gmail.com
IMAP_PASSWORD=
# OAuth access token can be used instead of an app password.
IMAP_ACCESS_TOKEN=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional directory containing eng.traineddata.gz for offline OCR.
OCR_LANG_PATH=
# Optional private JSON map of workspace IDs to their own integration settings.
# Additional workspaces never inherit the default workspace's mailbox/SMTP/Push keys.
# See docs/workspaces.md. Keep this file under the ignored data directory.
WORKSPACE_CONFIG_FILE=
