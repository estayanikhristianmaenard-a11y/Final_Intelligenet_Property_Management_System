# Separate local operational profile. This template contains no credentials.
# npm.cmd run setup:operational creates .env.operational without replacing an existing file.
# Only allowlisted connection settings are shared from .env. Acceptance is not loaded.
# Blank connection values below inherit shared values; delivery/intake stay OFF.
DATA_DIR=data/operational
HOST=127.0.0.1
PORT=8081
PORTAL_URL=http://localhost:8081/
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TLS_CERT_FILE=
TLS_KEY_FILE=
# Enable only after entering this profile's approved rent-mail settings.
RENT_EMAIL_ENABLED=false
UTILITY_INTAKE_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use a separate utility label/filter, not Rentara-Group3-Demo.
IMAP_HOST=
IMAP_PORT=993
IMAP_MAILBOX=Rentara-Utilities
IMAP_USER=
IMAP_PASSWORD=
IMAP_ACCESS_TOKEN=
# Optional; keep blank while actual-device Web Push testing is deferred.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OCR_LANG_PATH=
# Optional per-workspace credentials file must stay inside data/operational.
WORKSPACE_CONFIG_FILE=
