# Shared reference for the generated local HTTPS acceptance profile.
# Run setup:acceptance and setup:https -- --ip YOUR_LAPTOP_IPV4 instead of
# copying another laptop's .env.acceptance, database or TLS private keys.
# Base Gmail settings are read from the existing team .env.
DATA_DIR=data/acceptance
HOST=0.0.0.0
PORT=8443
PORTAL_URL=https://localhost:8443/
ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
TLS_CERT_FILE=data/local-tls/portal-cert.pem
TLS_KEY_FILE=data/local-tls/portal-key.pem
RENT_EMAIL_ENABLED=false
