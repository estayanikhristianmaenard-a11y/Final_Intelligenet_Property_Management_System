# Installed locally using npm ci; package.json and package-lock.json are shared.
node_modules/
# The project owner explicitly chose to share the team-owned .env through Git.
# Other environment variants remain local; the clean setup template is also shared.
.env.*
!.env
!.env.example
# Share named profile templates, while keeping generated laptop profiles local.
!.env.*.example
# Runtime databases, sessions, uploaded originals and private integration settings.
# npm run demo:group detects the IP and recreates missing local Group 3 setup.
# Its shared member template is in tools/; private keys and live sessions stay local.
data/
# Generated test output; tests and fixture source files are shared.
coverage/
test-results/
