        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n    subgraph ACTORS[\&quot;SYSTEM ACTORS\&quot;]\n        direction LR\n        UP[\&quot;Utility Provider\&quot;]\n        AD[\&quot;Admin\&quot;]\n        MG[\&quot;Manager\&quot;]\n        TN[\&quot;Tenant\&quot;]\n    end\n\n    subgraph INTAKE[\&quot;UTILITY-BILL INTAKE &amp; OCR\&quot;]\n        direction TB\n        EMAIL[\&quot;Property-Management Email Intake&lt;br/&gt;Utility-bill intake and attachment retrieval only\&quot;]\n        ATTACH[\&quot;Attachment Retrieval\&quot;]\n        SUPPORT[\&quot;Supported Document Processing\&quot;]\n        OCR[\&quot;OCR Processing&lt;br/&gt;Extracts available billing information\&quot;]\n        EXTRACTED[\&quot;Extracted Billing Information\&quot;]\n        FIELDS[\&quot;Target fields:&lt;br/&gt;Amount due; due date; billing period;&lt;br/&gt;utility provider; account/reference identifier\&quot;]\n\n        EMAIL --&gt; ATTACH --&gt; SUPPORT --&gt; OCR --&gt; EXTRACTED\n        OCR -.-&gt; FIELDS\n    end\n\n    subgraph CONFIG[\&quot;PROPERTY &amp; CONFIGURATION\&quot;]\n        direction LR\n        MAP[\&quot;Utility Provider and&lt;br/&gt;Account/Reference Mapping\&quot;]\n        PROP[\&quot;Property and Unit Management\&quot;]\n        TENMGMT[\&quot;Tenant Management\&quot;]\n        RENT[\&quot;Rent Configuration&lt;br/&gt;Monthly rent; lease-anniversary date;&lt;br/&gt;fixed and non-prorated; one-month advance rent\&quot;]\n    end\n\n    subgraph RULES[\&quot;RULE-BASED PROCESSING\&quot;]\n        direction LR\n        VALID[\&quot;Validation, Rule-Based Billing Classification,&lt;br/&gt;and Duplicate Checking&lt;br/&gt;Predefined, explicit, deterministic, and traceable rules\&quot;]\n        COMPUTE[\&quot;Billing Computation\&quot;]\n        EXC[\&quot;Exception Queue&lt;br/&gt;Manager review and correction; revalidation&lt;br/&gt;and reprocessing or recomputation when applicable\&quot;]\n    end\n\n    subgraph BPN[\&quot;BILLING, PAYMENT &amp; NOTIFICATION\&quot;]\n        direction LR\n        REC[\&quot;Billing Records\&quot;]\n        PSM[\&quot;Payment Status Management&lt;br/&gt;Unpaid → Tenant Reported Paid → Paid\&quot;]\n        PUSH[\&quot;Web Push Notification&lt;br/&gt;Permitted billing updates and due-date alerts;&lt;br/&gt;configured reminder three days before due date\&quot;]\n        DIGIT[\&quot;Digital Receipt&lt;br/&gt;Generated only after Manager-confirmed payment\&quot;]\n    end\n\n    subgraph DATA[\&quot;DATA LAYER\&quot;]\n        direction TB\n        DB[(\&quot;Centralized Database&lt;br/&gt;Property, unit, tenant, utility mappings,&lt;br/&gt;rent configuration, billing, payment status,&lt;br/&gt;exceptions, corrections, receipts, and&lt;br/&gt;applicable notification information\&quot;)]\n    end\n\n    UP --&gt;|\&quot;Sends electronic utility bill\&quot;| EMAIL\n\n    MG --&gt;|\&quot;Configuration and management\&quot;| PROP\n    MG --&gt;|\&quot;Configuration and management\&quot;| TENMGMT\n    MG --&gt;|\&quot;Configuration and management\&quot;| MAP\n    MG --&gt;|\&quot;Configuration and management\&quot;| RENT\n    MG --&gt;|\&quot;Review and correction\&quot;| EXC\n    MG --&gt;|\&quot;Manages billing records\&quot;| REC\n    MG --&gt;|\&quot;Confirms payment\&quot;| PSM\n\n    TN --&gt;|\&quot;Views billing and payment status\&quot;| REC\n    TN --&gt;|\&quot;Reports payment\&quot;| PSM\n    TN --&gt;|\&quot;Views confirmed-payment receipts\&quot;| DIGIT\n\n    PUSH --&gt;|\&quot;Directs to authenticated web portal\&quot;| TN\n\n    EXTRACTED --&gt;|\&quot;Extracted billing information\&quot;| VALID\n    MAP --&gt;|\&quot;Mapping data\&quot;| VALID\n    RENT --&gt;|\&quot;Rent and allocation rules\&quot;| VALID\n\n    VALID --&gt;|\&quot;Invalid, incomplete, uncertain, unmappable,&lt;br/&gt;or duplicate record\&quot;| EXC\n    VALID --&gt;|\&quot;Validated, non-duplicate record&lt;br/&gt;under applicable billing rules\&quot;| COMPUTE\n    EXC --&gt;|\&quot;Corrected record\&quot;| VALID\n\n    COMPUTE --&gt;|\&quot;Finalized billing information\&quot;| REC\n\n    REC --&gt; PSM\n    REC --&gt;|\&quot;Permitted billing and&lt;br/&gt;due-date alerts\&quot;| PUSH\n    PSM --&gt;|\&quot;Manager-confirmed payment only\&quot;| DIGIT\n\n    PROP -.-&gt;|\&quot;Property and unit records\&quot;| DB\n    TENMGMT -.-&gt;|\&quot;Tenant records\&quot;| DB\n    MAP -.-&gt;|\&quot;Utility mapping records\&quot;| DB\n    RENT -.-&gt;|\&quot;Rent configuration records\&quot;| DB\n    EXC -.-&gt;|\&quot;Exceptions and corrections\&quot;| DB\n    REC -.-&gt;|\&quot;Billing records\&quot;| DB\n    PSM -.-&gt;|\&quot;Payment-status records\&quot;| DB\n    DIGIT -.-&gt;|\&quot;Receipt records\&quot;| DB\n    PUSH -.-&gt;|\&quot;Applicable notification information\&quot;| DB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KLzBRVh5YApQ-wCuvRF--1407">
